<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La Perrera - Panel de Pedidos</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Inter:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
    --amarillo: #f5b81f;
    --rojo: #e8451c;
    --negro: #0d0d0d;
    --negro-2: #1a1a1a;
    --negro-3: #252525;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { background: var(--negro); color:#fff; font-family:'Inter',sans-serif; min-height:100vh; }

.topbar {
    background: var(--amarillo);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--negro);
    position: sticky;
    top: 0;
    z-index: 100;
}
.topbar h1 {
    font-family:'Archivo Black',sans-serif;
    color: var(--negro);
    font-size: 1.4rem;
    letter-spacing:-1px;
}
.btn-refresh {
    background: var(--rojo);
    color:#fff;
    border:none;
    padding: 10px 20px;
    font-family:'Anton',sans-serif;
    font-size: 1rem;
    letter-spacing:1px;
    border-radius:4px;
    cursor:pointer;
}

.wrap { padding: 24px; max-width: 900px; margin: 0 auto; }
.empty {
    text-align:center;
    color:#666;
    padding: 60px 20px;
    font-family:'Anton',sans-serif;
    font-size: 1.4rem;
    letter-spacing:2px;
}

.pedido {
    background: var(--negro-2);
    border-left: 5px solid var(--amarillo);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
}
.pedido-head {
    display:flex; justify-content:space-between; align-items:center;
    margin-bottom: 14px; flex-wrap:wrap; gap:8px;
}
.pedido-id {
    font-family:'Anton',sans-serif;
    color: var(--amarillo);
    font-size: 1.3rem;
    letter-spacing:1px;
}
.pedido-fecha { color:#888; font-size:0.85rem; }
.cliente {
    background: var(--negro-3);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 14px;
    font-size: 0.92rem;
    line-height: 1.7;
}
.cliente strong { color: var(--amarillo); }
.items {
    border-top: 1px dashed #444;
    border-bottom: 1px dashed #444;
    padding: 14px 0;
    margin-bottom: 14px;
    font-size: 0.92rem;
    line-height: 1.8;
}
.total {
    font-family:'Anton',sans-serif;
    color: var(--amarillo);
    font-size: 1.6rem;
    text-align: right;
    letter-spacing:1px;
    margin-bottom: 14px;
}
.btn-print {
    width:100%;
    background: var(--rojo);
    color:#fff;
    border:none;
    padding: 14px;
    font-family:'Anton',sans-serif;
    font-size: 1.05rem;
    letter-spacing:2px;
    border-radius:6px;
    cursor:pointer;
}
.btn-print:active { transform:scale(0.98); }

.btn-borrar {
    width:100%;
    background: transparent;
    color: #888;
    border: 1px solid #333;
    padding: 10px;
    font-family:'Anton',sans-serif;
    font-size: 0.9rem;
    letter-spacing:2px;
    border-radius:6px;
    cursor:pointer;
    margin-top: 8px;
}

@media print {
    body * { visibility: hidden; }
    .pedido, .pedido * { visibility: visible; }
    .pedido { position:absolute; left:0; top:0; width:100%; background:#fff; color:#000; border:none; }
    .btn-print, .btn-borrar, .topbar { display:none !important; }
    .cliente { background:#f0f0f0; }
    .pedido-id, .total { color:#000; }
    .cliente strong { color:#000; }
    .items { border-color:#000; }
}
</style>
</head>
<body>

<div class="topbar">
    <h1>🐶 PANEL LA PERRERA</h1>
    <button class="btn-refresh" onclick="cargar()">🔄 ACTUALIZAR</button>
</div>

<div class="wrap" id="lista"></div>

<script>
function cargar() {
    const lista = document.getElementById('lista');
    const pedidos = JSON.parse(localStorage.getItem('pedidosLaPerrera')) || [];

    if (pedidos.length === 0) {
        lista.innerHTML = '<div class="empty">NO HAY PEDIDOS AÚN 🐶</div>';
        return;
    }

    lista.innerHTML = pedidos.slice().reverse().map((p, idx) => {
        const realIdx = pedidos.length - 1 - idx;
        return `
        <div class="pedido" data-idx="${realIdx}">
            <div class="pedido-head">
                <span class="pedido-id">PEDIDO #${p.id.toString().slice(-4)}</span>
                <span class="pedido-fecha">${p.fecha}</span>
            </div>
            <div class="cliente">
                <div><strong>Cliente:</strong> ${p.cliente.nombre}</div>
                <div><strong>Teléfono:</strong> ${p.cliente.telefono}</div>
                <div><strong>Dirección:</strong> ${p.cliente.direccion}</div>
                <div><strong>Referencia:</strong> ${p.cliente.referencia || 'N/A'}</div>
                <div><strong>Notas:</strong> ${p.cliente.notas || 'Ninguna'}</div>
            </div>
            <div class="items">
                ${p.items.map(i => `<div>• ${i.cantidad} x ${i.nombre} — $${i.precio * i.cantidad}</div>`).join('')}
            </div>
            <div class="total">TOTAL: $${p.total}</div>
            <button class="btn-print" onclick="imprimir(${realIdx})">🖨️ IMPRIMIR RECIBO</button>
            <button class="btn-borrar" onclick="borrar(${realIdx})">✕ MARCAR COMO ENTREGADO</button>
        </div>
    `;
    }).join('');
}

function imprimir(idx) {
    const pedidos = JSON.parse(localStorage.getItem('pedidosLaPerrera')) || [];
    const p = pedidos[idx];
    if (!p) return;

    const w = window.open('', '', 'height=700,width=500');
    w.document.write(`
        <html><head><title>Recibo La Perrera</title>
        <style>
            body { font-family: sans-serif; padding: 20px; color: #000; max-width: 400px; }
            h1 { text-align: center; margin: 0; font-size: 1.6rem; }
            .sub { text-align: center; margin-top: 4px; margin-bottom: 20px; font-size: 0.9rem; color: #555; }
            .cliente { background: #f5f5f5; padding: 12px; border-radius: 6px; margin: 12px 0; font-size: 0.9rem; line-height: 1.6; }
            .items { border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 12px 0; font-size: 0.9rem; line-height: 1.7; }
            .total { text-align: right; font-size: 1.4rem; font-weight: bold; margin-top: 12px; }
            .fecha { text-align: right; font-size: 0.8rem; color: #555; margin-bottom: 12px; }
            .id { text-align: center; font-weight: bold; margin-bottom: 4px; }
        </style>
        </head><body>
        <h1>🐶 LA PERRERA</h1>
        <div class="sub">Hot Dogs Muy Perros</div>
        <div class="id">Pedido #${p.id.toString().slice(-4)}</div>
        <div class="fecha">${p.fecha}</div>
        <div class="cliente">
            <div><strong>Cliente:</strong> ${p.cliente.nombre}</div>
            <div><strong>Teléfono:</strong> ${p.cliente.telefono}</div>
            <div><strong>Dirección:</strong> ${p.cliente.direccion}</div>
            <div><strong>Referencia:</strong> ${p.cliente.referencia || 'N/A'}</div>
            <div><strong>Notas:</strong> ${p.cliente.notas || 'Ninguna'}</div>
        </div>
        <div class="items">
            ${p.items.map(i => `<div>• ${i.cantidad} x ${i.nombre} — $${i.precio * i.cantidad}</div>`).join('')}
        </div>
        <div class="total">TOTAL: $${p.total}</div>
        </body></html>
    `);
    w.document.close();
    w.focus();
    setTimeout(() => { w.print(); }, 300);
}

function borrar(idx) {
    if (!confirm('¿Marcar este pedido como entregado? Se eliminará del panel.')) return;
    const pedidos = JSON.parse(localStorage.getItem('pedidosLaPerrera')) || [];
    pedidos.splice(idx, 1);
    localStorage.setItem('pedidosLaPerrera', JSON.stringify(pedidos));
    cargar();
}

// Auto-recargar cada 5 segundos
cargar();
setInterval(cargar, 5000);
</script>
</body>
</html>
